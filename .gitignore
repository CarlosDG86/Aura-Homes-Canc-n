# Salida generada por la herramienta local graphify (grafo de conocimiento).
# No se versiona: se regenera con /graphify.
graphify-out/

# Imágenes fuente/originales (pesadas). Los originales viven en Drive; el repo
# solo versiona los assets ya optimizados en dist/assets/img/.
assets-src/

# Configuración local con credenciales (SMTP, llaves de API). Nunca se versiona.
.env
platform/.env

# Base de datos y fotos de la plataforma. Contienen datos de personas reales:
# no deben salir del equipo donde corren.
platform/data/*.db
platform/data/*.db.bak-*
platform/data/uploads/

# Registros y entornos virtuales.
*.log
.venv/
platform/.venv/
__pycache__/
*.pyc

# Fotos sueltas de las fichas de demostración: el CEO las deja en dist/ para
# mirarlas en local y no las usa ninguna página. `dist/` sí se versiona, así
# que sin esta regla vuelven a colarse en el primer `git add` que las roce.
dist/assets/img/aur-demo-*/front.PNG
dist/assets/img/aur-demo-*/Front.PNG
