{
  // Configuración para publicar el sitio público en Cloudflare.
  //
  // Cloudflare unificó Pages y Workers: el flujo de "Connect to Git" ahora crea
  // un Worker y despliega con `npx wrangler deploy`, que necesita este archivo.
  //
  // Aquí NO hay código de servidor: solo se sirven los archivos ya generados
  // por `build.py`. El sitio sigue siendo estático, como manda el alcance del
  // MVP — esto solo le dice a Cloudflare qué carpeta publicar.
  "name": "aura-homes-cancun",
  "compatibility_date": "2026-08-11",

  // Dominio oficial (D-033). La zona aurahomes.com.mx ya está en Cloudflare
  // (nameservers cullen/alexandra) y su correo ya funciona, pero hasta hoy
  // ningún registro llevaba el dominio al sitio: no resolvía. Con
  // "custom_domain", el próximo `wrangler deploy` crea él mismo el registro
  // DNS y el certificado; no hay que tocar DNS a mano.
  //
  // La URL de workers.dev se conserva para no romper ningún enlace viejo.
  "routes": [
    { "pattern": "aurahomes.com.mx", "custom_domain": true },
    { "pattern": "www.aurahomes.com.mx", "custom_domain": true }
  ],
  "workers_dev": true,

  "assets": {
    // Carpeta que genera `python build.py`.
    "directory": "./dist",

    // Sirve el index.html de cada carpeta (/es/ → /es/index.html) y conserva
    // las URL limpias del sitio.
    "html_handling": "auto-trailing-slash",

    // Una ruta inexistente sirve dist/404.html con estado 404. En modo
    // «Próximamente» esa página es la misma de «Próximamente» (build.py).
    "not_found_handling": "404-page"
  }
}
