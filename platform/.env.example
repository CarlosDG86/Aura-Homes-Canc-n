# Copy to platform/.env and adjust. As of the minimal .env loader in
# app/main.py, platform/.env IS now loaded automatically at startup — a
# variable exported in the shell still takes precedence over this file.
# Defaults below match what the app falls back to if unset, so it runs out of
# the box locally.

# Signs the session cookie (Starlette SessionMiddleware / itsdangerous).
# CHANGE THIS before any real deployment.
SECRET_KEY=dev-insecure-secret-key-change-me

# SQLite file lives at platform/data/platform.db by default.
DATABASE_URL=sqlite:///./data/platform.db

# Seed admin account created on first run (only if no admin user exists yet).
# CHANGE THIS PASSWORD before any real deployment.
SEED_ADMIN_EMAIL=admin@aura-homes-cancun.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Outbound email — owner onboarding + password resets (app/email_utils.py).
# Leave SMTP_HOST empty to keep the mailer in dev-mode (prints, sends nothing).
# For Gmail: enable 2-Step Verification, create an App Password (16 chars) and
# use it as SMTP_PASSWORD. Do NOT commit a filled-in .env (it is gitignored).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
