# Copy to .env and adjust — NOT loaded automatically (no python-dotenv dep,
# kept minimal per INFRA_STACK.md). Export these in your shell instead, or
# wire a dotenv loader later if that changes. Defaults below match what the
# app falls back to if these are unset, so it runs out of the box locally.

# Signs the session cookie (Starlette SessionMiddleware / itsdangerous).
# CHANGE THIS before any real deployment.
SECRET_KEY=dev-insecure-secret-key-change-me

# SQLite file lives at platform/data/platform.db by default.
DATABASE_URL=sqlite:///./data/platform.db

# Seed admin account created on first run (only if no admin user exists yet).
# CHANGE THIS PASSWORD before any real deployment.
SEED_ADMIN_EMAIL=admin@aura-homes-cancun.local
SEED_ADMIN_PASSWORD=ChangeMe123!
